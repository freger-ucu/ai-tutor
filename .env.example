# App
DEBUG=true
APP_ENV=development

# Backend
BACKEND_PORT=8000

# Frontend (Vite uses VITE_ prefix)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# LLM
LLM_PROVIDER=lapa
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# Redis
REDIS_URL=redis://redis:6379

# Phoenix (optional)
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=
