# App
DEBUG=true
APP_ENV=development

# Backend
BACKEND_PORT=8000

# Frontend (Vite uses VITE_ prefix)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Data
DATA_DIR=data

# LLM
LLM_PROVIDER=lapa
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Phoenix (optional observability)
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=
