# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Main LLM provider for reasoning-intensive tasks: "openai" | "gemini" | "lapa"
LLM_PROVIDER=openai

# Task-specific providers for simpler operations (recommendations, feedback)
# Uses Mamay model via Lapa endpoint for cost-efficiency
TASK_PROVIDER_FEEDBACK=mamay
TASK_PROVIDER_RECOMMENDATION=mamay

# =============================================================================
# OpenAI Configuration (Primary - for complex reasoning tasks)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# =============================================================================
# Lapa / Mamay Configuration (for simpler tasks)
# =============================================================================
LAPA_API_KEY=your-lapa-api-key
LAPA_BASE_URL=http://146.59.127.106:4000
LAPA_MODEL=mamay

# =============================================================================
# Gemini Configuration (alternative provider)
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Phoenix Telemetry (LLM Observability)
# =============================================================================
# Set to true to enable Phoenix tracing
PHOENIX_ENABLED=false
# Leave empty for local Phoenix UI at http://localhost:6006
# Or set to remote Phoenix endpoint
PHOENIX_ENDPOINT=

# =============================================================================
# LangSmith Tracing (optional)
# =============================================================================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=ai-tutor
LANGSMITH_FORCE_ENABLE=false
